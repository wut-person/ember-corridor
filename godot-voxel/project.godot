; 余烬回廊 · 体素 3D 角色工程（Godot 4.x）
; 用途：用盒子（BoxMesh）拼出 8 个角色的体素模型，按 8 个朝向渲染成精灵图，
;       供 HTML5 游戏直接使用（保持游戏零运行时依赖）。
; 运行方式：godot --headless --script 或 godot --render 配合 --shots

config_version=5

[application]

config/name="EmberVoxel"
config/description="余烬回廊 · 体素 3D 角色（8 角色 × 8 朝向）"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")

[display]

window/size/viewport_width=256
window/size/viewport_height=256
window/size/borderless=true
window/size/transparent=true
window/stretch/mode="disabled"

[rendering]

renderer/rendering_method="forward_plus"
textures/canvas_textures/default_texture_filter=0
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0, 0, 0, 0)
